TELEGRAM_BOT_TOKEN=
# ID чата: для https://t.me/c/2241331974/1 это -1002241331974
TELEGRAM_CHAT_ID=-1002241331974
# Заполнять только если группа в режиме форума — id темы
TELEGRAM_TOPIC_ID=
# Свой user id: только от него бот принимает команды
TELEGRAM_ADMIN_ID=

TWITCH_LOGIN=
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
YOUTUBE_CHANNEL_ID=
# Опционально: с ключом YouTube опрашивается через Data API, без ключа — парсингом страницы /live
YOUTUBE_API_KEY=
VKVIDEO_CHANNEL=
# Опционально: канал на vkvideo.ru, где лежат записи (https://vkvideo.ru/@...) — ссылка в сообщении об окончании эфира
VKVIDEO_REPLAY_URL=

# Как часто опрашивать платформы, мс
POLL_INTERVAL_MS=60000
# Сколько ждать после первой замеченной платформы, чтобы подтянулись остальные из OBS, мс
ANNOUNCE_GRACE_MS=90000
# Сколько молчания считать окончанием эфира (защита от переподключений), мс
OFFLINE_GRACE_MS=180000
# С какой платформы брать заголовок, игру и превью (с других площадок они не берутся)
PRIMARY_PLATFORM=twitch
# true — по окончании эфира отправить отдельное сообщение с длительностью и ссылками на записи
ANNOUNCE_END=true
# true — не отправлять в Telegram, только логировать, что было бы отправлено
DRY_RUN=false
DATABASE_PATH=./data/bot.db
